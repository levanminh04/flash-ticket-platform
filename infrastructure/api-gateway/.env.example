# Mẫu env của api-gateway. Copy thành .env cùng thư mục rồi điền secret.

# --- Giá trị container đang nhận ---
API_GATEWAY_PORT=8081
CORS_ALLOWED_ORIGINS=http://localhost:5173
EVENT_IMAGES_GATEWAY_TIME_LIMIT=50s
INTEGRATION_BOOKING_GATEWAY_TIME_LIMIT=25s
INTEGRATION_EVENT_GATEWAY_TIME_LIMIT=25s
INTEGRATION_GATEWAY_HTTP_RESPONSE_TIMEOUT=25s
INTEGRATION_PAYMENT_GATEWAY_TIME_LIMIT=25s
INTEGRATION_TICKET_GATEWAY_TIME_LIMIT=25s
INTEGRATION_USER_GATEWAY_TIME_LIMIT=25s
KEYCLOAK_ISSUER_URI=http://localhost:8080/realms/flash-ticket
KEYCLOAK_JWK_SET_URI=http://localhost:8080/realms/flash-ticket/protocol/openid-connect/certs
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379
GATEWAY_REDIS_TIMEOUT=10s

# Observability: activation is explicit; the pinned agent is already in the image.
OTEL_AGENT_ENABLED=false
SERVICE_VERSION=local-dev
ENVIRONMENT=local
HOST_ID=local-test
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_TRACES_SAMPLER=parentbased_always_on
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=none
SPRING_AUTOCONFIGURE_EXCLUDE=org.springframework.boot.data.redis.autoconfigure.observation.LettuceObservationAutoConfiguration
