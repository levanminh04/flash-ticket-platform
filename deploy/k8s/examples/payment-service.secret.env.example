# Chỉ tên biến, không điền secret thật vào Git.
# Required
PAYMENT_DB_PASSWORD=
RABBITMQ_PASSWORD=
PAYMENT_SERVICE_CLIENT_SECRET=
VNPAY_HASH_SECRET=
VNPAY_TMN_CODE=
# Optional
PAYMENT_INTERNAL_SERVICE_CLIENT_SECRET=
INTERNAL_SERVICE_CLIENT_SECRET=
# Reader default OFF; required values/timing được kiểm trước deploy khi ENABLED=true.
# JDBC: một private host:5432/payment_db?sslmode=require&targetServerType=secondary&connectTimeout=5&socketTimeout=5
# TLS require mã hóa nhưng không xác minh server identity; không điền secret thật vào Git.
PAYMENT_REPORT_REPLICA_ENABLED=
PAYMENT_REPORT_REPLICA_JDBC_URL=
PAYMENT_REPORT_REPLICA_USERNAME=
PAYMENT_REPORT_REPLICA_PASSWORD=
PAYMENT_REPORT_REPLICA_PROBE_INTERVAL=
PAYMENT_REPORT_REPLICA_PROBE_QUERY_TIMEOUT=
PAYMENT_REPORT_REPLICA_MAX_SAMPLE_AGE=
PAYMENT_REPORT_REPLICA_READER_TRANSACTION_TIMEOUT=
