# Chỉ tên biến, không điền secret thật vào Git.
# Required
PG_RW_HOST=
PG_RO_HOST=
PG_DB=
PG_USER=
PG_PASSWORD=
RABBITMQ_PASSWORD=
PAYMENT_SERVICE_CLIENT_SECRET=
VNPAY_HASH_SECRET=
VNPAY_TMN_CODE=
# Optional
# Production điền rõ pool5/2 trong env-file để giữ budget, mặc định ứng dụng10/10.
PG_WRITE_POOL_SIZE=
PG_READ_POOL_SIZE=
PAYMENT_INTERNAL_SERVICE_CLIENT_SECRET=
INTERNAL_SERVICE_CLIENT_SECRET=
# Không reader flag/gate/fallback; TLS require mã hóa nhưng không verify server identity.
