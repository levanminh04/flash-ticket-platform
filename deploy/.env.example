# Copy to .env and set the blank secrets before running Compose.
# Single quotes preserve literal $ in dotenv; do not add Keycloak escapes.
POSTGRES_USER=postgres
POSTGRES_DB=postgres
POSTGRES_PASSWORD=
POSTGRES_MEMORY_LIMIT=2g
PG_MAX_CONNECTIONS=100
PG_SHARED_BUFFERS=512MB
PG_WORK_MEM=4MB
PG_MAINTENANCE_WORK_MEM=128MB

KC_DB_URL=jdbc:postgresql://postgres:5432/keycloak_db
KC_DB_SCHEMA=keycloak
KC_DB_USERNAME=keycloak_app
KC_DB_PASSWORD=
KC_HOSTNAME=http://localhost:8080
KEYCLOAK_MEMORY_LIMIT=2g
KC_DB_POOL_MIN_SIZE=5
KC_DB_POOL_INITIAL_SIZE=5
KC_DB_POOL_MAX_SIZE=20
KC_HTTP_MAX_QUEUED_REQUESTS=100

# Realm SMTP settings: applied via Admin API, not automatically by Compose.
# Gmail requires an App Password; do not use the Google account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM=
SMTP_FROM_DISPLAY_NAME=FlashTicket
SMTP_USER=
SMTP_PASSWORD=
