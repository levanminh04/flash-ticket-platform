# Copy to deploy/.env.dev; used only to set up PostgreSQL and MongoDB with Compose.
# Single quotes preserve literal $ in dotenv; do not add Keycloak escapes.
# PostgreSQL creates this user/database on first initialization.
POSTGRES_USER=postgres
POSTGRES_DB=postgres
POSTGRES_PASSWORD=
POSTGRES_MEMORY_LIMIT=2g
PG_MAX_CONNECTIONS=100
PG_SHARED_BUFFERS=512MB
PG_WORK_MEM=4MB
PG_MAINTENANCE_WORK_MEM=128MB

# Business database initialization; keep matching runtime passwords in root .env.
EVENT_DB_ADMIN_PASSWORD=
EVENT_DB_VIEWER_PASSWORD=
BOOKING_DB_ADMIN_PASSWORD=
BOOKING_DB_VIEWER_PASSWORD=
PAYMENT_DB_ADMIN_PASSWORD=
PAYMENT_DB_VIEWER_PASSWORD=
TICKET_DB_ADMIN_PASSWORD=
TICKET_DB_VIEWER_PASSWORD=

# MongoDB initialization.
USER_DB_PORT=27017
USER_DB_ADMIN_PASSWORD=
USER_DB_VIEWER_PASSWORD=
