# Copy to .env.dev and set the blank secrets before running Compose.
# Single quotes preserve literal $ in dotenv; do not add Keycloak escapes.
# PostgreSQL creates this user/database on first initialization; Keycloak uses them too.
POSTGRES_USER=postgres
POSTGRES_DB=postgres
POSTGRES_PASSWORD=123456789a
POSTGRES_MEMORY_LIMIT=2g
PG_MAX_CONNECTIONS=100
PG_SHARED_BUFFERS=512MB
PG_WORK_MEM=4MB
PG_MAINTENANCE_WORK_MEM=128MB

# Optional overrides for an existing Keycloak database/schema.
# KC_DB_URL=jdbc:postgresql://postgres:5432/keycloak_db
# KC_DB_SCHEMA=keycloak
KC_HOSTNAME=http://localhost:8080
KC_BOOTSTRAP_ADMIN_USERNAME=admin@gmail.com
KC_BOOTSTRAP_ADMIN_PASSWORD=123456789a
KEYCLOAK_MEMORY_LIMIT=2g
KC_DB_POOL_MIN_SIZE=5
KC_DB_POOL_INITIAL_SIZE=5
KC_DB_POOL_MAX_SIZE=20
KC_HTTP_MAX_QUEUED_REQUESTS=100
