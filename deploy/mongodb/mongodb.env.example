# Non-secret runtime settings. Pin the same server image used by the source backup.
MONGO_IMAGE=mongo@sha256:98605bfa1bb2a15dd82109e1d78ad31527a9a744909fab4606076fa71a0ae515
MONGO_MEMORY_LIMIT=512m
MONGO_WIREDTIGER_CACHE_GB=0.25
MONGO_PORT=27017
MONGO_DATA_VOLUME=flash-ticket-mongodb-data
MONGO_NETWORK=flashticket_default
MONGO_ADMIN_ENV_FILE=/home/ubuntu/.config/flash-ticket-mongodb/admin.env
