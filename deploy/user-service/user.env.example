# Template only. Use a mode-0600 environment file on AWS2; never commit real values.
USER_SERVICE_PORT=8085
USER_SERVER_ADDRESS=127.0.0.1
USER_MEMORY_LIMIT=384m
CONFIG_SERVER_URL=http://127.0.0.1:18888
EUREKA_CLIENT_ENABLED=false
USER_MONGO_URI=mongodb://<runtime-user>:<url-encoded-password>@127.0.0.1:17017/user_db?authSource=user_db&maxPoolSize=5
USER_RABBITMQ_HOST=<reachable-broker-host>
USER_RABBITMQ_PORT=5672
USER_RABBITMQ_USERNAME=<scoped-broker-user>
USER_RABBITMQ_PASSWORD=<broker-password>
USER_RABBITMQ_VHOST=/
USER_KEYCLOAK_ISSUER_URI=<exact-public-issuer>
USER_KEYCLOAK_JWK_SET_URI=<reachable-jwks-uri>
USER_KEYCLOAK_AUDIENCE=flash-ticket-api
USER_KEYCLOAK_ADMIN_BASE_URL=<reachable-keycloak-root>
USER_KEYCLOAK_ADMIN_REALM=flash-ticket
USER_KEYCLOAK_ADMIN_CLIENT_ID=user-management
USER_KEYCLOAK_ADMIN_CLIENT_SECRET=<admin-client-secret>
USER_KEYCLOAK_ADMIN_TIMEOUT=5s
USER_ROLE_GRANT_LEASE_DURATION=60s
USER_ROLE_GRANT_WAIT_TIMEOUT=5s
USER_IMAGE_CLOUD_NAME=<cloud-name>
USER_IMAGE_API_KEY=<api-key>
USER_IMAGE_API_SECRET=<api-secret>
USER_IDENTITY_ENABLED=false
USER_IDENTITY_QUEUE=user.identity.q
USER_RECOVERY_ENABLED=false
USER_ENVIRONMENT=integration
# USER_SERVICE_VERSION is set automatically from the verified image revision by deploy-user.py.
USER_HOST_ID=aws2
