USER_TUNNEL_SSH_HOST=<aws1-public-ssh-host>
USER_TUNNEL_SSH_PORT=22
USER_TUNNEL_SSH_USER=ubuntu
USER_TUNNEL_KEY_FILE=/home/ubuntu/.config/flash-ticket-user/id_ed25519
USER_TUNNEL_KNOWN_HOSTS_FILE=/home/ubuntu/.config/flash-ticket-user/known_hosts
# MongoDB runs on AWS2; this tunnel now forwards only Config Server from AWS1.
USER_MONGO_TUNNEL_ENABLED=false
USER_MONGO_TUNNEL_PORT=17017
USER_CONFIG_TUNNEL_PORT=18888
USER_MONGO_REMOTE_PORT=27017
USER_CONFIG_REMOTE_PORT=8888
