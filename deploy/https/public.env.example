# Giá trị public production. Không dùng thay file env có secret đang chạy.
# Keycloak: ghép vào ENV_KEYCLOAK và /opt/flash-ticket-app/env/keycloak.env.
KC_HOSTNAME=https://auth.flashticket.sondimid.cloud
KC_HTTP_ENABLED=true
KC_PROXY_HEADERS=xforwarded
# Kiểm lại Pod CIDR/địa chỉ nguồn proxy trước cutover.
KC_PROXY_TRUSTED_ADDRESSES=10.42.0.0/16,172.31.41.236/32

# GitHub repo Variables: frontend cần build lại, restart không thay bundle.
VITE_API_GATEWAY_URL=https://flashticket.sondimid.cloud
VITE_KEYCLOAK_URL=https://auth.flashticket.sondimid.cloud
VITE_KEYCLOAK_REALM=flash-ticket
VITE_KEYCLOAK_CLIENT_ID=frontend

# Các ENV_* backend: đồng bộ nguồn dù runtime K3s lấy issuer từ ConfigMap.
KEYCLOAK_ISSUER_URI=https://auth.flashticket.sondimid.cloud/realms/flash-ticket
