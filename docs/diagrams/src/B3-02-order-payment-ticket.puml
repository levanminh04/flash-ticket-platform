@startuml
title B3-02 — Chọn vé, giữ chỗ, thanh toán và phát hành vé

|Người mua|
start
:Chọn vé của một event;
if (SEAT_MAP?) then (Có)
  :Chọn trong đúng một sector;
endif

|Hệ thống|
:Kiểm tra mở bán, nguồn cung, giới hạn mua và loại vé;
if (Hợp lệ?) then (Không)
  :Từ chối, không tạo giữ chỗ;
  stop
else (Có)
  :Tạo một đơn, một giữ chỗ và một thời hạn chung;
endif

|Người mua|
if (Áp dụng mã?) then (Có)
  |Hệ thống|
  :Kiểm tra mã thuộc event, hiệu lực, lượt dùng và giá cuối > 0;
  if (Mã hợp lệ?) then (Có)
    :Giữ lượt dùng cùng đơn;
  else (Không)
    :Thông báo không áp dụng mã;
  endif
endif

|Hệ thống|
if (Đơn hết hạn trước thanh toán?) then (Có)
  :Đánh dấu đơn và giữ chỗ hết hạn;
  :Trả tài nguyên tạm giữ đúng một lần;
  :Chặn lần thanh toán mới;
  stop
endif

|Người mua|
if (Hủy đơn trước khi thu tiền?) then (Có)
  |Hệ thống|
  :Hủy đơn và trả tài nguyên đúng một lần;
  :Chặn lần thanh toán mới;
  stop
endif
:Khởi tạo thanh toán;

|Cổng thanh toán|
:Trả callback/IPN;
|Hệ thống|
:Bỏ qua tác dụng phụ nếu callback đã được xử lý;
if (Đơn đã hết hạn hoặc bị hủy?) then (Có)
  :Tạo yêu cầu hoàn toàn bộ;
  :Không trả tài nguyên lần hai;
  stop
endif
if (Thanh toán hợp lệ?) then (Không)
  if (Đơn còn hiệu lực?) then (Có)
    |Người mua|
    :Có thể tạo lần thử mới tuần tự;
  endif
  stop
endif
:Chỉ giữ một kết quả thu hợp lệ;
:Phát hành vé;
if (Phát hành thành công?) then (Không)
  :Vô hiệu vé dở dang;
  :Trả lượt khuyến mãi đúng một lần;
  if (Event vẫn đủ điều kiện bán?) then (Có)
    :Trả nguồn cung và giới hạn mua đúng một lần;
  endif
  :Tạo yêu cầu hoàn toàn bộ;
  stop
else (Có)
  :Cho buyer xem/tải QR của đơn mình;
  :Thử gửi thông tin vé;
  if (Gửi thất bại?) then (Có)
    :Giữ vé hợp lệ và cho phép tải/gửi lại;
  endif
endif
if (Phát hiện giao dịch thu thừa?) then (Có)
  :Giữ giao dịch và vé hợp lệ;
  :Tạo yêu cầu hoàn toàn bộ cho từng khoản thu thừa;
endif
stop
@enduml
