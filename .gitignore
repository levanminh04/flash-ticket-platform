# Local environment files and secrets
.env
.env.*
!.env.example
!**/.env.example
**/.env
**/.env.*
!**/.env.example

# Credentials and private keys
*.pem
*.key
*.p12
*.pfx
credentials.json
service-account*.json

# Claude Code local wiring
# .claude/skills/govern-capstone-work is a filesystem junction to
# .agents/skills/govern-capstone-work. Git resolves it and would commit the same
# files twice, so ignore the mirror and keep .agents/ as the tracked source.
.claude/skills/govern-capstone-work/

# IDE and operating-system files
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db
~$*.docx

# Build and dependency outputs
**/target/
**/build/
**/dist/
**/node_modules/
.gradle/

# Runtime and test artifacts
*.log
logs/
tmp/
coverage/
test-results/
