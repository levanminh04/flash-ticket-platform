# Keycloak on server 84 (/opt/flash-ticket-app/env/keycloak.env, mode 600).
# Keycloak joins the Docker network flash-ticket-infra, so DB and broker use container hostnames.
KC_DB=postgres
KC_DB_URL=jdbc:postgresql://postgres:5432/keycloak_db
KC_DB_USERNAME=keycloak_admin
KC_DB_PASSWORD=
KC_HOSTNAME=http://52.64.237.84:8080
KC_HTTP_ENABLED=true
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=
KC_DB_POOL_MIN_SIZE=2
KC_DB_POOL_INITIAL_SIZE=2
KC_DB_POOL_MAX_SIZE=10
KC_HTTP_MAX_QUEUED_REQUESTS=100
FT_IDENTITY_OUTBOX_ENABLED=true
FT_IDENTITY_OUTBOX_INTERVAL_MS=2000
FT_IDENTITY_RABBITMQ_HOST=rabbitmq
FT_IDENTITY_RABBITMQ_PORT=5672
FT_IDENTITY_RABBITMQ_VHOST=/
FT_IDENTITY_RABBITMQ_USERNAME=flash_ticket_identity
FT_IDENTITY_RABBITMQ_PASSWORD=
