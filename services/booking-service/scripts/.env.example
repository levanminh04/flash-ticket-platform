# Only the disposable curl harness uses this template. It never loads root .env.
# Run: rtk proxy python -X utf8 services/booking-service/scripts/test-event-availability-curl.py
# The harness copies values into target/availability-curl/*.env and generates
# blank passwords/secrets there. Docker loads those files with --env-file.
# All credentials and the realm import are removed during cleanup.
POSTGRES_DB=booking_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
RABBITMQ_DEFAULT_USER=booking_curl
RABBITMQ_DEFAULT_PASS=
KC_HOSTNAME=http://booking-availability-curl-kc:8080
JAVA_OPTS_KC_HEAP=-Xms128m -Xmx384m
BOOKING_DB_URL=jdbc:postgresql://booking-availability-curl-pg:5432/booking_db
BOOKING_DB_USERNAME=booking_admin
BOOKING_DB_PASSWORD=
RABBITMQ_HOST=booking-availability-curl-rabbit
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=booking_curl
RABBITMQ_PASSWORD=
REDIS_HOST=booking-availability-curl-redis
REDIS_PORT=6379
REDIS_PASSWORD=
KEYCLOAK_ISSUER_URI=http://booking-availability-curl-kc:8080/realms/availability-curl
KEYCLOAK_TOKEN_URI=http://booking-availability-curl-kc:8080/realms/availability-curl/protocol/openid-connect/token
INTERNAL_SERVICE_CLIENT_SECRET=
BOOKING_SERVICE_PORT=8082
BOOKING_ENVIRONMENT=isolated-availability-curl
SPRING_APPLICATION_NAME=booking-service
SPRING_CONFIG_LOCATION=file:/runtime/booking-service.yaml
SPRING_CLOUD_CONFIG_ENABLED=false
EUREKA_CLIENT_ENABLED=false
SPRING_JPA_HIBERNATE_DDL_AUTO=none
BOOKING_EXPIRY_ENABLED=false
BOOKING_RESERVATION_HOLD_DURATION=PT30S
