# Mẫu env của booking-service. Copy thành .env cùng thư mục rồi điền secret.

# --- Giá trị container đang nhận ---
BOOKING_DB_PASSWORD=
BOOKING_DB_URL=jdbc:postgresql://127.0.0.1:5432/booking_db
BOOKING_DB_USERNAME=booking_admin
BOOKING_DDL_AUTO=none
# Chỉ bật sau khi kiểm mạng private, TLS và quyền SELECT; URL chỉ trỏ standby.
BOOKING_SALES_CHART_REPLICA_ENABLED=false
# Hai nhóm dùng chung pool/gate pilot; chỉ bật khi base flag trên đã bật và đạt budget 60s.
BOOKING_SALES_ORGANIZER_REPORT_REPLICA_ENABLED=false
BOOKING_SALES_EVENT_REPORT_REPLICA_ENABLED=false
BOOKING_SALES_CHART_REPLICA_JDBC_URL=
BOOKING_SALES_CHART_REPLICA_USERNAME=
BOOKING_SALES_CHART_REPLICA_PASSWORD=
# Interval và tuổi mẫu là Duration (ISO-8601); hai timeout tính bằng giây.
BOOKING_SALES_CHART_REPLICA_PROBE_INTERVAL=
BOOKING_SALES_CHART_REPLICA_PROBE_QUERY_TIMEOUT=
BOOKING_SALES_CHART_REPLICA_MAX_SAMPLE_AGE=
BOOKING_SALES_CHART_REPLICA_READER_TRANSACTION_TIMEOUT=
BOOKING_SERVICE_PORT=8082
INTERNAL_SERVICE_CLIENT_SECRET=
KEYCLOAK_ISSUER_URI=http://localhost:8080/realms/flash-ticket
KEYCLOAK_TOKEN_URI=http://localhost:8080/realms/flash-ticket/protocol/openid-connect/token
PAYMENT_SERVICE_CLIENT_ID=internal-service
PAYMENT_SERVICE_TOKEN_URI=http://localhost:8080/realms/flash-ticket/protocol/openid-connect/token
RABBITMQ_BUSINESS_EXCHANGE=business.ex
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PASSWORD=
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=flash_ticket_app
RABBITMQ_VHOST=/
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379
SPRING_JPA_HIBERNATE_DDL_AUTO=none
