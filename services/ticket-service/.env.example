# Mẫu env của ticket-service. Copy thành .env cùng thư mục rồi điền secret.

# --- Giá trị container đang nhận ---
INTERNAL_SERVICE_CLIENT_SECRET=
KEYCLOAK_AUDIENCE=flash-ticket-api
KEYCLOAK_ISSUER_URI=http://localhost:8080/realms/flash-ticket
KEYCLOAK_JWK_SET_URI=http://localhost:8080/realms/flash-ticket/protocol/openid-connect/certs
MAIL_HOST=smtp.gmail.com
MAIL_PASSWORD=
MAIL_PORT=587
MAIL_USERNAME=
RABBITMQ_BUSINESS_EXCHANGE=business.ex
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PASSWORD=
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=flash_ticket_app
RABBITMQ_VHOST=/
TICKET_BUSINESS_ENABLED=true
TICKET_DB_PASSWORD=
TICKET_DB_URL=jdbc:postgresql://127.0.0.1:5432/ticket_db
TICKET_DB_USERNAME=ticket_admin
TICKET_LISTENERS_ENABLED=true
TICKET_MAIL_HEALTH_ENABLED=false
TICKET_QR_ACTIVE_KEY_VERSION=v1
TICKET_QR_KEY_RING_LOCATION=file:/run/ticket-qr/keys.json
TICKET_SERVICE_PORT=8084
TICKET_WORKERS_ENABLED=true

# --- Cấu hình riêng của service ---
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
MAIL_SMTP_STARTTLS_REQUIRED=true
TICKET_ACCESS_CONFIGURED_QUEUE=ticket.access-configured.q
TICKET_COMPLETED_RESULT_MESSAGE_TYPE=ticket.issuance-result.v1
TICKET_COMPLETED_RESULT_ROUTING_KEY=ticket.issuance-result.v1
TICKET_DELIVERY_CLAIM_LEASE=60s
TICKET_DELIVERY_DISPLAY_ZONE=Asia/Ho_Chi_Minh
TICKET_EVENT_CANCELLED_QUEUE=ticket.event-cancelled.q
TICKET_FAILED_RESULT_ROUTING_KEY=ticket.issuance-result.v1
TICKET_ISSUANCE_QUEUE=ticket.issuance.q
TICKET_KEYCLOAK_AUDIENCE=flash-ticket-api
TICKET_MAIL_FROM=
TICKET_OUTBOX_CLAIM_LEASE=30s
TICKET_OUTBOX_CONFIRM_TIMEOUT=5s
TICKET_WORKER_BATCH_SIZE=20
TICKET_WORKER_POLL_DELAY=1s

# --- Dùng cho compose deploy riêng của service ---
TICKET_INTERNAL_SERVICE_CLIENT_SECRET=
TICKET_BUYER_BASE_URL=

# Observability: activation is explicit; the pinned agent is already in the image.
OTEL_AGENT_ENABLED=false
SERVICE_VERSION=local-dev
ENVIRONMENT=local
HOST_ID=local-test
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_TRACES_SAMPLER=parentbased_always_on
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=none
OTEL_INSTRUMENTATION_RABBITMQ_EXPERIMENTAL_SPAN_ATTRIBUTES=true
FT_FAULTS_ENABLED=false
FT_FAULT_CONTROL_FILE=/run/fault-control/control.json
FT_FAULT_AUDIT_FILE=/run/fault-audit/executions.jsonl
