# Synthetic fixture only. prepare writes a fresh ignored env file; never use production .env.
# Fixed loopback ports15432/15433; conflicts stop rather than change ports.
TICKET_TEST_DB_URL=jdbc:postgresql://127.0.0.1:15432/ticket_test_c1
TICKET_TEST_DB_USER=ticket_ci
TICKET_TEST_DB_PASSWORD=
TICKET_LIST_REPLICA_ENABLED=true
TICKET_LIST_REPLICA_JDBC_URL=jdbc:postgresql://127.0.0.1:15433/ticket_test_c1?targetServerType=secondary
TICKET_LIST_REPLICA_USERNAME=ticket_reader
TICKET_LIST_REPLICA_PASSWORD=
TICKET_LIST_REPLICA_PROBE_INTERVAL=PT1S
TICKET_LIST_REPLICA_PROBE_QUERY_TIMEOUT=1
TICKET_LIST_REPLICA_MAX_SAMPLE_AGE=PT2S
TICKET_LIST_REPLICA_READER_TRANSACTION_TIMEOUT=5
# Private vhost on an owned disposable broker only.
TICKET_TEST_RABBIT_PORT=5672
TICKET_TEST_RABBIT_USER=
TICKET_TEST_RABBIT_PASSWORD=
TICKET_TEST_RABBIT_VHOST=
