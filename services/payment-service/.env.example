# Mẫu env của payment-service. Copy thành .env cùng thư mục rồi điền secret.

# --- Giá trị container đang nhận ---
INTERNAL_SERVICE_CLIENT_SECRET=
KEYCLOAK_AUDIENCE=flash-ticket-api
KEYCLOAK_ISSUER_URI=http://localhost:8080/realms/flash-ticket
KEYCLOAK_JWK_SET_URI=http://localhost:8080/realms/flash-ticket/protocol/openid-connect/certs
KEYCLOAK_TOKEN_URI=http://localhost:8080/realms/flash-ticket/protocol/openid-connect/token
PAYMENT_DB_PASSWORD=
PAYMENT_DB_URL=jdbc:postgresql://127.0.0.1:5432/payment_db
PAYMENT_DB_USERNAME=payment_admin
PAYMENT_INTERNAL_SERVICE_CLIENT_SECRET=
PAYMENT_SERVICE_CLIENT_ID=internal-service
PAYMENT_SERVICE_CLIENT_SECRET=
PAYMENT_SERVICE_PORT=8083
PAYMENT_SERVICE_TOKEN_URI=http://localhost:8080/realms/flash-ticket/protocol/openid-connect/token
PAYMENT_VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
RABBITMQ_BUSINESS_EXCHANGE=business.ex
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PASSWORD=
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=flash_ticket_app
RABBITMQ_VHOST=/
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_APP_RETURN_URL=flash-ticket://payment-return
VNPAY_HASH_SECRET=
VNPAY_IPN_URL=http://localhost:8083/api/v1/payments/vnpay/ipn
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:8083/api/v1/payments/vnpay/return
VNPAY_TMN_CODE=

# --- Dùng cho compose deploy riêng của service ---
PAYMENT_VNPAY_ENABLED=false
PAYMENT_VNPAY_CALLBACKS_ENABLED=false
PAYMENT_VNPAY_ENVIRONMENT=sandbox
PAYMENT_DOCKER_BOOKING_URL=http://127.0.0.1:8082
PAYMENT_WORKER_ENABLED=true
NGROK_AUTHTOKEN=
NGROK_DOMAIN=subjacently-unsuppliable-tobi.ngrok-free.dev
