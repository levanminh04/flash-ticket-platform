# Mẫu env của user-service. Copy thành .env cùng thư mục rồi điền secret.

# --- Giá trị container đang nhận ---
KEYCLOAK_AUDIENCE=flash-ticket-api
KEYCLOAK_ISSUER_URI=http://localhost:8080/realms/flash-ticket
KEYCLOAK_JWK_SET_URI=http://localhost:8080/realms/flash-ticket/protocol/openid-connect/certs
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PASSWORD=
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=flash_ticket_app
RABBITMQ_VHOST=/
USER_IDENTITY_ENABLED=true
USER_KEYCLOAK_ADMIN_BASE_URL=http://localhost:8080
USER_KEYCLOAK_ADMIN_CLIENT_ID=user-management
USER_KEYCLOAK_ADMIN_CLIENT_SECRET=
USER_KEYCLOAK_ADMIN_REALM=flash-ticket
USER_KEYCLOAK_ADMIN_TIMEOUT=5s
USER_MONGO_URI=mongodb://<user>:<password>@127.0.0.1:27017/user_db?authSource=admin
USER_RECOVERY_ENABLED=true
USER_SERVICE_PORT=8085

# --- Cấu hình riêng của service ---
KEYCLOAK_IDENTITY_REALM_ID=
MONGO_URI=mongodb://<user>:<password>@127.0.0.1:27017/user_db?authSource=admin
USER_IDENTITY_MAX_MESSAGE_BYTES=65536
USER_IDENTITY_QUEUE=user.identity.q
USER_IMAGE_API_KEY=
USER_IMAGE_API_SECRET=
USER_IMAGE_CLOUD_NAME=dofmwh97j
USER_IMAGE_FOLDER=flash-ticket/organizers
USER_IMAGE_MAX_BYTES=2097152
USER_IMAGE_MAX_FILE_SIZE=2MB
USER_IMAGE_MAX_PIXELS=16000000
USER_IMAGE_MAX_REQUEST_SIZE=3MB
USER_IMAGE_TIMEOUT=5s
USER_KEYCLOAK_AUDIENCE=flash-ticket-api
USER_MONGO_COLLECTION_PREFIX=tbl_
USER_RABBITMQ_PASSWORD=
USER_RABBITMQ_USERNAME=flash_ticket_app
USER_RECOVERY_BATCH_SIZE=20
USER_RECOVERY_DELAY=30s
USER_ROLE_GRANT_LEASE_DURATION=60s
USER_ROLE_GRANT_WAIT_TIMEOUT=5s

# --- Dùng cho compose deploy riêng của service ---
USER_SERVER_ADDRESS=0.0.0.0
USER_MEMORY_LIMIT=384m
USER_JAVA_OPTIONS=-XX:MaxRAMPercentage=60.0 -Duser.timezone=UTC
USER_ENVIRONMENT=local
USER_HOST_ID=developer-laptop
