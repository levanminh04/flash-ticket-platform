# Mẫu env của event-service. Copy thành .env cùng thư mục rồi điền secret.

# --- Giá trị container đang nhận ---
EVENT_DB_PASSWORD=
EVENT_DB_URL=jdbc:postgresql://127.0.0.1:5432/event_db?currentSchema=event_schema
EVENT_DB_USERNAME=event_admin
EVENT_IMAGES_API_KEY=
EVENT_IMAGES_API_SECRET=
EVENT_IMAGES_CLOUD_NAME=dofmwh97j
EVENT_OUTBOX_ENABLED=true
EVENT_READ_MODEL_ENABLED=true
EVENT_SERVICE_PORT=8086
INTERNAL_SERVICE_CLIENT_SECRET=
KEYCLOAK_AUDIENCE=flash-ticket-api
KEYCLOAK_ISSUER_URI=http://localhost:8080/realms/flash-ticket
KEYCLOAK_JWK_SET_URI=http://localhost:8080/realms/flash-ticket/protocol/openid-connect/certs
KEYCLOAK_TOKEN_URI=http://localhost:8080/realms/flash-ticket/protocol/openid-connect/token
PAYMENT_SERVICE_CLIENT_ID=internal-service
PAYMENT_SERVICE_TOKEN_URI=http://localhost:8080/realms/flash-ticket/protocol/openid-connect/token
RABBITMQ_BUSINESS_EXCHANGE=business.ex
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PASSWORD=
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=flash_ticket_app
RABBITMQ_VHOST=/

# --- Cấu hình riêng của service ---
EVENT_CANCELLATION_SUMMARY_MAX_AGE=30s
EVENT_IMAGES_FOLDER=flash-ticket/events
EVENT_IMAGES_MAX_BYTES=5242880
EVENT_IMAGES_MAX_COUNT=20
EVENT_IMAGES_MAX_PIXELS=16000000
EVENT_IMAGES_MAX_REQUEST_BYTES=6291456
EVENT_IMAGES_TIMEOUT=10s
EVENT_INTERNAL_SERVICE_CLIENT_SECRET=
EVENT_KEYCLOAK_AUDIENCE=flash-ticket-api
EVENT_KEYCLOAK_ISSUER_URI=http://localhost:8080/realms/flash-ticket
EVENT_KEYCLOAK_JWK_SET_URI=http://localhost:8080/realms/flash-ticket/protocol/openid-connect/certs
EVENT_KEYCLOAK_TOKEN_URI=http://localhost:8080/realms/flash-ticket/protocol/openid-connect/token
EVENT_OUTBOX_BATCH_SIZE=20
EVENT_OUTBOX_CONFIRM_TIMEOUT=5s
EVENT_OUTBOX_INITIAL_RETRY=1s
EVENT_OUTBOX_LEASE=30s
EVENT_OUTBOX_MAXIMUM_RETRY=5m
EVENT_OUTBOX_POLL_DELAY=1s
EVENT_RABBITMQ_BUSINESS_EXCHANGE=business.ex
EVENT_RABBITMQ_HOST=127.0.0.1
EVENT_RABBITMQ_PASSWORD=
EVENT_RABBITMQ_PORT=5672
EVENT_RABBITMQ_USERNAME=flash_ticket_app
EVENT_RABBITMQ_VHOST=/
EVENT_READ_CLOCK_SKEW=5s
EVENT_READ_CONNECT_TIMEOUT=10s
EVENT_READ_RESPONSE_TIMEOUT=20s

# --- Dùng cho compose deploy riêng của service ---
EVENT_SERVER_ADDRESS=0.0.0.0
EVENT_MEMORY_LIMIT=1g
EVENT_JAVA_OPTIONS=-XX:MaxRAMPercentage=50.0 -Duser.timezone=UTC
EVENT_IMAGES_GATEWAY_TIME_LIMIT=50s
EVENT_ENVIRONMENT=local
EVENT_HOST_ID=developer-laptop
EVENT_BOOKING_BASE_URL=http://booking-service:8082
EVENT_PAYMENT_BASE_URL=http://payment-service:8083

# Observability: activation is explicit; the pinned agent is already in the image.
OTEL_AGENT_ENABLED=false
SERVICE_VERSION=local-dev
ENVIRONMENT=local
HOST_ID=local-test
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_TRACES_SAMPLER=parentbased_always_on
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=none
OTEL_INSTRUMENTATION_RABBITMQ_EXPERIMENTAL_SPAN_ATTRIBUTES=true
FT_FAULTS_ENABLED=false
FT_FAULT_CONTROL_FILE=/run/fault-control/control.json
FT_FAULT_AUDIT_FILE=/run/fault-audit/executions.jsonl
