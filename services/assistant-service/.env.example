# Copy thành .env, nạp bằng env-file/IDE hiện có. Không commit .env.
# Spring/Maven không tự nạp .env. Không bù biến thiếu bằng CLI/JVM/biến tạm.
# Chốt port trước khi chạy; không tự đổi port khi xung đột.
ASSISTANT_SERVICE_PORT=

# Đối chiếu issuer và Redis với env Booking/Gateway của cùng môi trường.
# Eureka lấy từ env gốc nếu cùng môi trường chạy.
KEYCLOAK_ISSUER_URI=
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
EUREKA_SERVER_URL=

# Base URL của proxy OpenAI-compatible, không gắn /chat/completions.
ASSISTANT_MODEL_BASE_URL=https://model.sondimid.cloud/v1
ASSISTANT_MODEL_NAME=gemini-3.8-flash-high
# Điền API key của proxy vào file local; không gửi qua chat hoặc log.
ASSISTANT_MODEL_API_KEY=

# Origin http(s)://host[:port], không path/query/fragment/userinfo.
# Chọn theo nơi Assistant chạy: hostname Docker không mặc nhiên dùng được trên Windows.
ASSISTANT_EVENT_BASE_URL=
ASSISTANT_BOOKING_BASE_URL=

# Namespace runtime riêng của Assistant, chỉ chữ/số/:/_/-, tối đa 160 ký tự.
# Redis IT cần env-file test riêng, prefix chứa :test: và quyền ghi key test.
ASSISTANT_REDIS_KEY_PREFIX=
