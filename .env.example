# Copy to .env at the repository root. This is the only local env file.
# Spring does not read .env automatically; configure the IDE/runtime to load it.
# Never commit local secrets.

CONFIG_SERVER_URL=http://localhost:8888
CONFIG_SERVER_PORT=8888
EUREKA_SERVER_URL=http://localhost:8761/eureka/
DISCOVERY_SERVER_PORT=8761
API_GATEWAY_PORT=8081
EVENT_SERVICE_PORT=8086
BOOKING_SERVICE_PORT=8082
PAYMENT_SERVICE_PORT=8083
TICKET_SERVICE_PORT=8084
USER_SERVICE_PORT=8085

KEYCLOAK_ISSUER_URI=http://localhost:8080/realms/flash-ticket
KEYCLOAK_JWK_SET_URI=http://localhost:8080/realms/flash-ticket/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Redis standalone: password required for local Compose.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=flash_ticket_app
RABBITMQ_PASSWORD=
RABBITMQ_ADMIN_USERNAME=flash_ticket_admin
RABBITMQ_ADMIN_PASSWORD=
RABBITMQ_IDENTITY_USERNAME=flash_ticket_identity
RABBITMQ_IDENTITY_PASSWORD=
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_MEMORY_LIMIT=1g

# Application database connections. Match each password to the corresponding
# <SERVICE>_DB_ADMIN_PASSWORD below.
EVENT_DB_URL=jdbc:postgresql://127.0.0.1:5432/event_db
EVENT_DB_USERNAME=event_admin
EVENT_DB_PASSWORD=
BOOKING_DB_URL=jdbc:postgresql://127.0.0.1:5432/booking_db
BOOKING_DB_USERNAME=booking_admin
BOOKING_DB_PASSWORD=
PAYMENT_DB_URL=jdbc:postgresql://127.0.0.1:5432/payment_db
PAYMENT_DB_USERNAME=payment_admin
PAYMENT_DB_PASSWORD=
TICKET_DB_URL=jdbc:postgresql://127.0.0.1:5432/ticket_db
TICKET_DB_USERNAME=ticket_admin
TICKET_DB_PASSWORD=
# mongodb://user_admin:<URL-encoded USER_DB_ADMIN_PASSWORD>@127.0.0.1:27017/user_db?authSource=admin
MONGO_URI=

MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=

# PostgreSQL and MongoDB initialization for local Compose.
POSTGRES_USER=postgres
POSTGRES_DB=keycloak_db
POSTGRES_PASSWORD=
POSTGRES_MEMORY_LIMIT=2g
PG_MAX_CONNECTIONS=100
PG_SHARED_BUFFERS=512MB
PG_WORK_MEM=4MB
PG_MAINTENANCE_WORK_MEM=128MB

# Business database initialization. Keep runtime passwords above equal to these.
EVENT_DB_ADMIN_PASSWORD=
EVENT_DB_VIEWER_PASSWORD=
BOOKING_DB_ADMIN_PASSWORD=
BOOKING_DB_VIEWER_PASSWORD=
PAYMENT_DB_ADMIN_PASSWORD=
PAYMENT_DB_VIEWER_PASSWORD=
TICKET_DB_ADMIN_PASSWORD=
TICKET_DB_VIEWER_PASSWORD=

# MongoDB initialization.
USER_DB_PORT=27017
USER_DB_ADMIN_PASSWORD=
USER_DB_VIEWER_PASSWORD=

# Keycloak Compose runtime.
KC_DB_URL=jdbc:postgresql://postgres:5432/keycloak_db
KC_HOSTNAME=http://localhost:8080
KC_BOOTSTRAP_ADMIN_USERNAME=admin@gmail.com
KC_BOOTSTRAP_ADMIN_PASSWORD=
KEYCLOAK_MEMORY_LIMIT=2g
KC_DB_POOL_MIN_SIZE=5
KC_DB_POOL_INITIAL_SIZE=5
KC_DB_POOL_MAX_SIZE=20
KC_HTTP_MAX_QUEUED_REQUESTS=100
