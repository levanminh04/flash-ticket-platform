# Copy thành .env ở root. Chỉ chứa hạ tầng, frontend và biến dùng chung cho Compose ở root.
# Env của từng service: xem <service>/.env.example (api-gateway, discovery-server, config-server và 5 service nghiệp vụ).

CONFIG_SERVER_URL=http://localhost:8888
EUREKA_SERVER_URL=http://localhost:8761/eureka/
API_GATEWAY_PORT=8081
REDIS_PORT=6379
REDIS_PASSWORD=
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=flash_ticket_app
RABBITMQ_PASSWORD=
RABBITMQ_ADMIN_USERNAME=flash_ticket_admin
RABBITMQ_IDENTITY_USERNAME=flash_ticket_identity
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_MEMORY_LIMIT=1g
RABBITMQ_ADMIN_PASSWORD=
RABBITMQ_IDENTITY_PASSWORD=
RABBITMQ_VHOST=/
SERVER_ADDRESS=0.0.0.0
POSTGRES_USER=postgres
POSTGRES_DB=keycloak_db
POSTGRES_PASSWORD=
KC_DB_URL=jdbc:postgresql://postgres:5432/keycloak_db
KC_HOSTNAME=http://localhost:8080
KC_BOOTSTRAP_ADMIN_USERNAME=
KC_BOOTSTRAP_ADMIN_PASSWORD=
KEYCLOAK_MEMORY_LIMIT=2g
KC_DB_POOL_MIN_SIZE=5
KC_DB_POOL_INITIAL_SIZE=5
KC_DB_POOL_MAX_SIZE=20
KC_HTTP_MAX_QUEUED_REQUESTS=100
POSTGRES_MEMORY_LIMIT=2g
PG_MAX_CONNECTIONS=100
PG_SHARED_BUFFERS=512MB
PG_WORK_MEM=4MB
PG_MAINTENANCE_WORK_MEM=128MB
EVENT_DB_ADMIN_PASSWORD=
EVENT_DB_VIEWER_PASSWORD=
BOOKING_DB_ADMIN_PASSWORD=
BOOKING_DB_VIEWER_PASSWORD=
PAYMENT_DB_ADMIN_PASSWORD=
PAYMENT_DB_VIEWER_PASSWORD=
TICKET_DB_ADMIN_PASSWORD=
TICKET_DB_VIEWER_PASSWORD=
USER_DB_PORT=27017
USER_DB_ADMIN_PASSWORD=
USER_DB_VIEWER_PASSWORD=
LOGGING_STRUCTURED_FORMAT_CONSOLE=
BOOKING_SERVICE_URL=http://booking-service:8082
VITE_API_GATEWAY_URL=http://127.0.0.1:8081
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=flash-ticket
VITE_KEYCLOAK_CLIENT_ID=frontend
INTEGRATION_EVENT_DB_URL=jdbc:postgresql://127.0.0.1:5432/event_db?currentSchema=event_schema
INTEGRATION_BOOKING_DB_URL=jdbc:postgresql://127.0.0.1:5432/booking_db
INTEGRATION_BOOKING_DDL_AUTO=none
INTEGRATION_PAYMENT_DB_URL=jdbc:postgresql://127.0.0.1:5432/payment_db
INTEGRATION_TICKET_DB_URL=jdbc:postgresql://127.0.0.1:5432/ticket_db
INTEGRATION_MONGO_URI=mongodb://<user>:<password>@127.0.0.1:27017/user_db?authSource=admin
INTEGRATION_TICKET_QR_KEY_RING_FILE=../.integration-secrets/ticket/key-ring.json
